DirectoryIndex index.html
Options -Indexes

# Branded 404 page (served with a real 404 status)
ErrorDocument 404 /404.html

# --- Canonical host: force https + apex (skip ACME/SSL validation) ----------
# The site is canonical at https://lonestargate.com, so send every other
# host/protocol there with a single 301 to avoid duplicate content.
<IfModule mod_rewrite.c>
  RewriteEngine On

  # Never redirect ACME challenge requests (keeps Let's Encrypt renewal working)
  RewriteCond %{REQUEST_URI} ^/\.well-known/ [NC]
  RewriteRule ^ - [L]

  RewriteCond %{HTTPS} off [OR]
  RewriteCond %{HTTP_HOST} ^www\. [NC]
  RewriteRule ^ https://lonestargate.com%{REQUEST_URI} [R=301,L]
</IfModule>

<IfModule mod_headers.c>
Header always set X-Content-Type-Options "nosniff"
Header always set Strict-Transport-Security "max-age=31536000"
Header always set X-Frame-Options "DENY"
Header always set Referrer-Policy "strict-origin-when-cross-origin"
Header always set Permissions-Policy "camera=(), microphone=(), geolocation=()"
Header always set Content-Security-Policy "default-src 'self'; base-uri 'self'; object-src 'none'; script-src 'self'; style-src 'self' 'unsafe-inline'; font-src 'self' data:; img-src 'self' data:; connect-src 'self'; form-action 'self'; frame-ancestors 'none'"
</IfModule>

<IfModule mod_expires.c>
ExpiresActive On
ExpiresByType text/html "access plus 0 seconds"
ExpiresByType text/css "access plus 30 days"
ExpiresByType application/javascript "access plus 30 days"
ExpiresByType application/xml "access plus 7 days"
ExpiresByType text/plain "access plus 7 days"
ExpiresByType image/jpeg "access plus 1 year"
ExpiresByType image/png "access plus 1 year"
ExpiresByType image/webp "access plus 1 year"
ExpiresByType image/svg+xml "access plus 1 year"
ExpiresByType image/x-icon "access plus 1 year"
ExpiresByType font/woff2 "access plus 1 year"
</IfModule>

<IfModule mod_headers.c>
  <FilesMatch "\.(css|js|woff2|jpg|jpeg|png|webp|svg|ico|gif)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>
  <FilesMatch "\.(html|htm)$">
    Header set Cache-Control "public, max-age=0, must-revalidate"
  </FilesMatch>
</IfModule>

<IfModule mod_deflate.c>
AddOutputFilterByType DEFLATE text/html text/css application/javascript application/json application/xml text/plain image/svg+xml
</IfModule>

<IfModule mod_mime.c>
AddType font/woff2 .woff2
AddType image/webp .webp
</IfModule>

# Allow search engine files
<IfModule mod_authz_core.c>
  <FilesMatch "^(robots\.txt|sitemap\.xml)$">
    Require all granted
  </FilesMatch>
</IfModule>
<IfModule !mod_authz_core.c>
  <FilesMatch "^(robots\.txt|sitemap\.xml)$">
    Order allow,deny
    Allow from all
  </FilesMatch>
</IfModule>

# --- Hardening: never serve project internals in production -----------------
# The Git deployment copies the whole repository into the web root, so dev
# tooling (tests, scripts, package manifests, .git) must be denied explicitly.

# Dotfiles: .git, .gitignore, .npmrc, .nvmrc, .htmlvalidate.json, .env, ...
<FilesMatch "^\.">
  <IfModule mod_authz_core.c>
    Require all denied
  </IfModule>
  <IfModule !mod_authz_core.c>
    Order allow,deny
    Deny from all
  </IfModule>
</FilesMatch>

# Project metadata files
<FilesMatch "^(package\.json|package-lock\.json|README\.md)$">
  <IfModule mod_authz_core.c>
    Require all denied
  </IfModule>
  <IfModule !mod_authz_core.c>
    Order allow,deny
    Deny from all
  </IfModule>
</FilesMatch>

# Build/test tooling by extension
<FilesMatch "\.(mjs|py)$">
  <IfModule mod_authz_core.c>
    Require all denied
  </IfModule>
  <IfModule !mod_authz_core.c>
    Order allow,deny
    Deny from all
  </IfModule>
</FilesMatch>

# tests/ and scripts/ directories in full
<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteRule ^(tests|scripts)/ - [F,L]
</IfModule>
<IfModule mod_alias.c>
  RedirectMatch 403 ^/(tests|scripts)(/|$)
</IfModule>

# --- Character encoding in HTTP headers -------------------------------------
AddDefaultCharset UTF-8
AddType 'text/html; charset=UTF-8' .html .htm
AddType 'text/css; charset=UTF-8' .css
AddType 'application/javascript; charset=UTF-8' .js
AddType 'application/xml; charset=UTF-8' .xml
